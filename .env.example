# Translator to use
## Options are LLM, DEEPL, LIBRE, or LUNA
TRANSLATOR=DEEPL

# Path to LRC/SRT/VTT/etc files to translate
## For a list of supported formats, please see https://github.com/papnkukn/subsrt
RJ_PATH=./queue

# Path to backup folder
BAK_PATH=./backup

# Path to output folder
OUT_PATH=./output

# Path to dictionary file (comma-delimited)
## Used for post-processing only. Each line should contain the following format: `from word,to word`
DICTIONARY_FILE=./data/dictionary.csv

# LLM Config
## Chat Completions URL (must be OpenAI API-compatible)
LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
## API key or bearer token
LLM_API_KEY=<REPLACE_WITH_API_KEY_OR_AUTH_TOKEN>
## Model to use
LLM_MODEL=tencent/hy-mt2-30b-a3b
## Additional Parameters
### System prompt (be sure to include any source / target languages)
LLM_PARAM_PROMPT=You are a translator. Please help me translate the following text into English. You should only tell me the translation result without any additional explanations.
### Temperature
LLM_PARAM_TEMPERATURE=0.3
### Top-P
LLM_PARAM_TOP_P=0.7
### Top-K
LLM_PARAM_TOP_K=
### Repetition Penalty
LLM_PARAM_REPETITION_PENALTY=

# DeepL Config
## The DeepL API Key
### https://support.deepl.com/hc/en-us/articles/360020695820
DEEPL_API_KEY=<REPLACE_WITH_API_KEY>
## DeepL-compatible source language code
### https://developers.deepl.com/docs/resources/supported-languages#source-languages
DEEPL_SOURCE_LANG=zh
## DeepL-compatible target language code
### https://developers.deepl.com/docs/resources/supported-languages#target-languages
DEEPL_TARGET_LANG=en-US

# LibreTranslate Config
## Endpoint to use
LIBRE_ENDPOINT=http://127.0.0.1:5000/
## Libre-compatible source language code
### https://libretranslate.com/languages
LIBRE_SOURCE_LANG=zh
## Libre-compatible target language code
### https://libretranslate.com/languages
LIBRE_TARGET_LANG=en

# LunaTranslator Config
## Endpoint to use
LUNA_ENDPOINT=http://127.0.0.1:2333/
## Translator to use
### For a list of translators available, please visit http://127.0.0.1:2333/api/list/translator (replace ip/port if needed)
### You must configure the translators yourself within LunaTranslator
### If not provided, will default to the first available translator
LUNA_TRANSLATOR=Sugoi